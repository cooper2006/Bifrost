<resources>
    <!-- Displayed when Samsung returns an unexpected HTTP status. The format argument shows the raw error -->
    <string name="badReturnStatus">返回错误状态：%1$s</string>
    <!-- Displayed when Samsung isn't serving the firmware file for a request model and region combination -->
    <string name="noBinaryFile">没有找到地区代码%1$s，%2$s! 请尝试一个不同的CSC代码。</string>
    <!-- Displayed when a user attempts to manually download a specific firmware, but the firmware Samsung is serving doesn't match -->
    <string name="versionMismatch">你请求
\n
\n%1$s
\n
\n但是三星服务器试图提供
\n
\n%2$s
\n
\n你确定要继续下载吗？</string>
    <!-- Displayed when a user attempts to manually download a specific firmware, but Bifrost wasn't able to verify that Samsung is serving the correct version -->
    <string name="versionCheckError">不能验证三星提供了正确的固件，你确定要下载吗？</string>
    <!-- Displayed when a user selects a file on the Decrypt screen that doesn't have an enc2 or enc4 extension -->
    <string name="selectEncrypted">请选择一个以enc2或enc4为结尾的加密固件。</string>
    <!-- Displayed when the CRC calculated from the downloaded firmware doesn't match the CRC value provided by Samsung -->
    <string name="crcCheckFailed">CRC校验未通过。 请删除文件并重新下载。</string>
    <!-- Displayed when the MD5 calculated from the downloaded firmware doesn't match the MD5 value provided by Samsung -->
    <string name="md5CheckFailed">MD5 校验失败。 请删除文件并重新下载。</string>
    <!-- Displayed when something goes wrong while checking for the latest firmware for a specific model and region -->
    <string name="firmwareCheckError">找不到固件。请检查设备型号和地区是否正确。
\n更多信息：%1$s
\n
\n%2$s</string>
    <!-- Displayed when the user enables the "Manual" checkbox -->
    <string name="manualWarning">警告！三星也许不会提供请求的固件！</string>
    <!-- A detailed message describing how Samsung doesn't always serve the requested firmware version if it's entered manually -->
    <string name="manualWarningDetails">对于大多数设备，三星只会提供最新的固件。即使你请求了一个不同的版本，三星服务器依旧只会返回最新的固件。为了有效防止刷入错误的固件，%1$s 在你下载之前会检查三星是否提供了请求的固件。如果请求的固件和提供的版本不一致，%2$s 会中止下载。要了解该问题的更多信息，查看</string>
    <!-- A continuation of manualWarningDetails -->
    <string name="manualWarningDetails2">这个问题</string>
    <!-- A continuation of manualWarningDetails -->
    <string name="manualWarningDetails3">在Github上。</string>
    <!-- Displayed when an error occurs while checking for firmware history for a specific model and region -->
    <string name="historyError">不能找到固件记录，请确认设备型号和地区是否正确。</string>
    <!-- Displayed when an error occurs while checking for firmware history for a specific model and region, and a specific error is available -->
    <string name="historyErrorFormat">不能找到固件记录，请检查设备型号和地区是否正确。
\n错误代码：%1$s</string>
    <!-- Displayed when decrypting an encrypted firmware file fails. -->
    <string name="decryptError">不能解密固件。确保正确的设备型号，地区和固件。
\n错误代码：%1$s</string>
